# =============================================================
# AI Affiliate Tech Blog — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control!
# =============================================================

# -------------------------
# OpenAI API Configuration
# -------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# -------------------------
# Affiliate Network IDs
# -------------------------
# Amazon Associates
AMAZON_AFFILIATE_TAG=yourtag-20

# ShareASale
SHAREASALE_MERCHANT_ID=your-merchant-id
SHAREASALE_AFFILIATE_ID=your-affiliate-id

# Impact
IMPACT_ACCOUNT_SID=your-impact-account-sid

# CJ Affiliate
CJ_WEBSITE_ID=your-cj-website-id

# -------------------------
# Site Configuration
# -------------------------
SITE_URL=https://yourdomain.com
SITE_NAME=AI Tech Reviews
SITE_DESCRIPTION=AI-powered tech product reviews and buying guides

# -------------------------
# Analytics (optional)
# -------------------------
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# -------------------------
# Local Preview Server
# -------------------------
# Port for the local preview server (default: 3000)
# PORT=3000

